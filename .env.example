# Copy this file to .env and fill in your Firebase project's web config.
# Get these values from: Firebase Console > Project Settings > General > Your apps > Web app.
# These are safe to keep in a local .env (gitignored) rather than hardcoded in source.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Base URL of the Flask backend. Defaults to http://localhost:5000 if unset.
REACT_APP_API_BASE_URL=http://localhost:5000
