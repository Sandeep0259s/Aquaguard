# Copy this file to backend/.env and fill in your own Gemini API key.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Production settings (defaults are fine for local dev — leave unset).
# Comma-separated list of frontend origins allowed to call this API in
# production, e.g. https://myapp.vercel.app. Defaults to "*" (any origin).
ALLOWED_ORIGINS=*
# Set to "false" in production so Flask's debugger isn't exposed.
FLASK_DEBUG=true
# Most hosts (Render, Railway, Heroku) inject PORT automatically.
PORT=5000
